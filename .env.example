# Aurelia Botanica - Production Configuration Template
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL

# MONGODB CONNECTION STRING
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.example.mongodb.net/aurelia_ecommerce

# SPRING BOOT & EXPRESS SERVER CONFIGURATION
PORT=8080
SERVER_PORT=8080

# JWT AUTHENTICATION CONFIGURATION
# Generate a cryptographically secure 512-bit key for production
JWT_SECRET=9a82f41c6d3b4e5f7a8c9b0e1d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6a7f8e9d0c
JWT_EXPIRATION=86400000

# CORS & FRONTEND CLIENT URL
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DEVELOPMENT SEED SETTINGS
SEED_DATA_ENABLED=true
ADMIN_DEV_PASSWORD=Admin@12345

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
